.swiftpm/xcode/xcuserdata/
Markdown.xcodeproj/xcuserdata/
CLAUDE.md
/.claude

# macOS
.DS_Store
# Finder folder icon: a file named Icon plus a carriage return
Icon[
]

# Build
DerivedData/
xcuserdata/
*.xcuserstate

# Secrets
.env

# Agents (local agent instructions, settings and boards)
AGENTS.md
.claude/
.codex/
KANBAN*.md

# Package pins: the .xcodeproj's Package.resolved is committed and a release builds from it alone (security audit
# H2: release.sh's check). The -Local workspace and SwiftPM's own pins follow the checkouts next to this one
# (V57_LOCAL=1) or GitHub's main, so they stay unpinned
/Package.resolved
/Markdown.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/Markdown.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
/Markdown-Local.xcworkspace/xcshareddata/
