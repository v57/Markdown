<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Security-scoped bookmarks: sidebar folders stay readable across launches.
	     The sandbox, user-selected-files and network entitlements come from build settings. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Notes sync through the vault's CloudKit container (iCloud.dev.v57). The app's iCloud Drive folder is
	     where earlier versions kept notes: they are imported from it once (NotesLocation). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(CFBundleIdentifier)</string>
		<string>iCloud.dev.v57</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.$(CFBundleIdentifier)</string>
	</array>
	<!-- The v57 vault (../Vault): the projects the v57 apps share, in the app group container, and the
	     key that encrypts notes (and the GitHub sign-in) in the shared keychain group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)dev.v57</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.v57.shared</string>
	</array>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
</dict>
</plist>
