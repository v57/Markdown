# How Tools/release/release.sh ships this app (see release.env.example).
APP_NAME=Markdown
SCHEME=Markdown
PROJECT=Markdown.xcodeproj
WORKSPACE=
PLATFORM=macos
TEAM_ID=AUCR797TMH
VERSION=0.1.0

TEST_SCHEME=
TEST_DESTINATION=
SCREENSHOT_TEST=
SCREENSHOT_LOCALES=en-US
SCREENSHOT_DESTINATION=

DIRECT_DOWNLOAD='zip dmg'
DIRECT_ARCHS=arm64
DIRECT_SETTINGS='SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) DIRECT_DISTRIBUTION'
NOTARY_PROFILE=notary

GITHUB_REPO=v57/Markdown
GITHUB_DRAFT=yes

APP_STORE=no

# Windows and Linux (built on a VM), Android, and their stores.
WINDOWS_PRODUCT=MarkdownWinUI
LINUX_PRODUCT=MarkdownEditor
LINUX_CATEGORIES=Utility;TextEditor;

# Translations from v57/Localizations (Code's xcodebuild-release): the sources KitLanguages.start(sources:) names, best
# first, and the languages the app ships with (the others are downloaded on request).
LANGUAGE_SOURCES='Markdown MarkdownKit ComponentKit VaultUI GitHubUI'
LANGUAGES_BUNDLED='de fr es ja zh-Hans pt-BR ko it ru'
# The v57/Localizations commit the release takes its translations from (release-languages; a full commit hash, never
# a branch).
LOCALIZATIONS_REF=1460796b645817aaaefab724f9c1f72d21ab1841

# Package pins: the committed Package.resolved pins the v57 libraries' main branches at pushed revisions (they have
# no tags yet): release.sh takes them at those revisions and archives from that file alone.
RELEASE_PINS=revision
