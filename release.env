# How Tools/release/release.sh ships this app (see release.env.example).
APP_NAME=Markdown
SCHEME=Markdown
PROJECT=
WORKSPACE=Markdown-Local.xcworkspace
PLATFORM=macos
TEAM_ID=AUCR797TMH

# Translations from v57/Localizations (Code's xcodebuild-release): the sources KitLanguages.start(sources:) names, best
# first, and the languages the app ships with (the others are downloaded on request).
LANGUAGE_SOURCES='Markdown MarkdownKit ComponentKit VaultUI GitHubUI'
LANGUAGES_BUNDLED='de fr es ja zh-Hans pt-BR ko it ru'

TEST_SCHEME=
TEST_DESTINATION=
SCREENSHOT_TEST=
SCREENSHOT_LOCALES=en-US
SCREENSHOT_DESTINATION=

DIRECT_DOWNLOAD='zip dmg'
DIRECT_ARCHS=universal
DIRECT_SETTINGS='SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) DIRECT_DISTRIBUTION'
NOTARY_PROFILE=v57-notary

GITHUB_REPO=v57/Markdown
GITHUB_DRAFT=yes

APP_STORE=no
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

WINDOWS_PRODUCT=MarkdownWinUI
LINUX_PRODUCT=MarkdownEditor
